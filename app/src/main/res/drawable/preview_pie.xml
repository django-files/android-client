<?xml version="1.0" encoding="utf-8"?>
<!-- Static fake pie for the widget picker preview (previewLayout is never
    bound by the provider, so runtime fills this in on the real widget).
    Ring sized to ~64% hole like the real donut; 2-degree trims fake the
    sliceSpace gaps. Butt caps: round caps would swallow thin gaps since a
    cap extends half the stroke width past each arc end. -->
