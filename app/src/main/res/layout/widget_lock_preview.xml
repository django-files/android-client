<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview only (referenced by previewLayout in xml/widget_lock.xml).
    Never inflated by WidgetLockProvider, so all sample content is baked in
    as real attributes: static pie, legend colors, example counts. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_lock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:theme="@style/WidgetStyle"
    tools:layout_width="320dp"
    tools:layout_height="240dp"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lock_files_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:textAppearance="@style/TextAppearance.AppCompat.Body2"
                android:textSize="14sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Files 0 • 0 MB" />

            <TextView
                android:id="@+id/lock_right_summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textAppearance="@style/TextAppearance.AppCompat.Body2"
                android:textSize="14sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="start"
                android:text="Shorts 0 · Albums 0" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginVertical="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/lock_chart"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:contentDescription="Storage by type"
                android:src="@drawable/preview_pie" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:id="@+id/lock_legend0_color"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="#565AA9"
                        android:contentDescription="Legend color" />
                    <TextView
                        android:id="@+id/lock_legend0_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
                        android:textSize="13sp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:maxWidth="112dp"
                        android:text="image/jpeg" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:id="@+id/lock_legend1_color"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="#2FB4B6"
                        android:contentDescription="Legend color" />
                    <TextView
                        android:id="@+id/lock_legend1_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
                        android:textSize="13sp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:maxWidth="112dp"
                        android:text="image/png" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:id="@+id/lock_legend2_color"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="#F97066"
                        android:contentDescription="Legend color" />
                    <TextView
                        android:id="@+id/lock_legend2_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
                        android:textSize="13sp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:maxWidth="112dp"
                        android:text="video/mp4" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:id="@+id/lock_legend3_color"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="#F5B041"
                        android:contentDescription="Legend color" />

                    <TextView
                        android:id="@+id/lock_legend3_name"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:maxWidth="112dp"
                        android:text="image/gif"
                        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:id="@+id/lock_legend4_color"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="#EC4899"
                        android:contentDescription="Legend color" />
                    <TextView
                        android:id="@+id/lock_legend4_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
                        android:textSize="13sp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:maxWidth="112dp"
                        android:text="txt/plain" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:id="@+id/lock_legend5_color"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="#5DD39E"
                        android:contentDescription="Legend color" />
                    <TextView
                        android:id="@+id/lock_legend5_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
                        android:textSize="13sp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:maxWidth="112dp"
                        android:text="application/zip" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:id="@+id/lock_legend6_color"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="#94A3B8"
                        android:contentDescription="Legend color" />
                    <TextView
                        android:id="@+id/lock_legend6_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
                        android:textSize="13sp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:maxWidth="112dp"
                        android:text="other" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/lock_text_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_lock_ripple_white">

                <ImageView
                    android:id="@+id/lock_text_button"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Upload Text"
                    android:src="@drawable/md_text_snippet_24px" />

                <TextView
                    android:id="@+id/lock_text_pill_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:maxLines="1"
                    android:text="Text" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lock_upload_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_lock_ripple_white">

                <ImageView
                    android:id="@+id/lock_upload_button"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Upload File"
                    android:src="@drawable/md_upload_24px" />

                <TextView
                    android:id="@+id/lock_upload_pill_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:maxLines="1"
                    android:text="File" />
            </LinearLayout>

            <TextView
                android:id="@+id/lock_update_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:maxLines="1"
                android:ellipsize="start"
                android:text="Updated 23:59" />

            <LinearLayout
                android:id="@+id/lock_refresh_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_lock_ripple_white">

                <ImageView
                    android:id="@+id/lock_refresh_button"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Refresh stats"
                    android:src="@drawable/md_refresh_24px" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
