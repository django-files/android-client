<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.djangofiles" parent="Theme.Material3.DayNight.NoActionBar">
        <!--<item name="colorPrimary">@color/primary</item>-->
    </style>
    <style name="Theme.djangofiles" parent="Base.Theme.djangofiles" />

    <!-- https://developer.android.com/develop/ui/views/launch/splash-screen -->
    <style name="Theme.djangofiles.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.djangofiles</item>
        <!-- https://developer.android.com/reference/android/R.attr#windowSplashScreenBehavior -->
        <item name="android:windowSplashScreenBehavior" tools:targetApi="33">icon_preferred</item>
    </style>

    <style name="AlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/AlertDialogCorner</item>
    </style>

    <style name="AlertDialogCorner" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="WidgetStyle" parent="Theme.MaterialComponents.DayNight" />
    <style name="Theme.WidgetConfig.Transparent" parent="Theme.djangofiles">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>

        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="BottomNavigation.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:height">30dp</item>
    </style>

    <!--<style name="BottomNavigation.TextActive" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">-->
    <!--    <item name="android:textSize">12sp</item>-->
    <!--</style>-->
    <!--<style name="BottomNavigation.TextInactive" parent="TextAppearance.AppCompat">-->
    <!--    <item name="android:textSize">10sp</item>-->
    <!--</style>-->
</resources>
